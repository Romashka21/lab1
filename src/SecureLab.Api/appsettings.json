{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "RateLimit": {
    "Login": { "PermitLimit": 20, "WindowSeconds": 60 },
    "Search": { "PermitLimit": 20, "WindowSeconds": 60 }
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "AllowReset": false
  }
}
